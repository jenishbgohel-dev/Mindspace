rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default-deny all writes & reads
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Secure server-side admin check:
    // 1. Firebase Auth custom claims set by Firebase Admin SDK (token.admin == true or token.role == 'admin')
    // 2. OR verified entry in the protected /admins/{uid} collection
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // Administrator registry: only admins can list; users can verify their own record; client writes disabled
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    // Audit log of authenticated logins
    match /loginHistory/{logId} {
      // Authenticated users can only record their own login event (cannot forge someone else's UID)
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.providerId is string;

      // STRICT PROTECTION: Only authorized administrators can read all users' login history.
      // Ordinary users can only read their own login events.
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      // Audit records are strictly immutable: no updates or deletions permitted
      allow update, delete: if false;
    }

    // User profile document rules
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && isValidString(request.resource.data.email, 200);
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId;
      allow delete: if false;

      // Tasks subcollection
      match /tasks/{taskId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && isValidString(request.resource.data.title, 250);
        allow update: if isOwner(userId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // Goals subcollection
      match /goals/{goalId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && isValidString(request.resource.data.title, 250);
        allow update: if isOwner(userId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
